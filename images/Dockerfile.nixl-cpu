# ============================================================================
# CPU-only NIXLBench image (no CUDA, no GPU, no vLLM)
# ============================================================================
# Builds UCX, NIXL (UCX plugin only) and nixlbench from source on a plain
# Ubuntu base and ships only the installed results. This is much smaller than
# the old vLLM-based GPU image, and it runs on
# nodes without GPUs: use `execution.nixl.gpu: false` in the profile.
#
# Stages (each is independent, so BuildKit caches and parallelizes them):
#   toolchain -> ucx -> nixl -> nixlbench -> dist -> runtime image
#   nixl-src (git clone) feeds nixl and nixlbench.
#
# The data path is DRAM <-> DRAM over UCX 
# (TCP, plus RDMA if the pod sees a verbs device). 
# VRAM transfers are not available.
#
# Build:
#   docker build -f images/Dockerfile.nixl-cpu \
#     -t <registry>/nixl-benchmark:cpu images/

ARG UBUNTU_VERSION=24.04

# ---------------------------------------------------------------------------
# Shared compiler toolchain and build dependencies.
# ---------------------------------------------------------------------------
FROM ubuntu:${UBUNTU_VERSION} AS toolchain

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libasio-dev \
        libgflags-dev \
        libhwloc-dev \
        libibverbs-dev \
        libnuma-dev \
        librdmacm-dev \
        libtool \
        libtomlplusplus-dev \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/build-venv && \
    /opt/build-venv/bin/pip install --no-cache-dir meson
ENV PATH=/opt/build-venv/bin:${PATH}

# ---------------------------------------------------------------------------
# UCX, without CUDA.
# ---------------------------------------------------------------------------
FROM toolchain AS ucx

ARG UCX_VERSION=1.22.0

RUN set -eux; \
    curl -fsSL "https://github.com/openucx/ucx/releases/download/v${UCX_VERSION}/ucx-${UCX_VERSION}.tar.gz" | tar -xz -C /tmp; \
    cd "/tmp/ucx-${UCX_VERSION}"; \
    ./contrib/configure-release \
        --prefix=/opt/ucx \
        --enable-mt \
        --without-cuda \
        --without-go \
        --without-java \
        --without-gdrcopy; \
    make -j"$(nproc)"; \
    make install; \
    rm -rf "/tmp/ucx-${UCX_VERSION}"

# ---------------------------------------------------------------------------
# NIXL sources (headers, core and the nixlbench sources live in one repo).
# ---------------------------------------------------------------------------
FROM ubuntu:${UBUNTU_VERSION} AS nixl-src

ARG NIXL_VERSION=v1.4.1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${NIXL_VERSION}" https://github.com/ai-dynamo/nixl.git /src/nixl

# ---------------------------------------------------------------------------
# NIXL core with the UCX plugin only.
# ---------------------------------------------------------------------------
FROM toolchain AS nixl

# NIXL v1.4.1 builds its Python bindings unconditionally, so pybind11 and the
# Python headers are needed at build time. The extension is dropped in `dist`.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        pybind11-dev \
        python3-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ucx /opt/ucx /opt/ucx
COPY --from=nixl-src /src/nixl /src/nixl

RUN set -eux; \
    meson setup /tmp/nixl-build /src/nixl \
        --prefix=/opt/nixl \
        --buildtype=release \
        -Dlibdir=lib \
        -Ducx_path=/opt/ucx \
        -Denable_plugins=UCX \
        -Dbuild_tests=false \
        -Dbuild_examples=false \
        -Dwith_trace=false; \
    ninja -C /tmp/nixl-build; \
    ninja -C /tmp/nixl-build install

# ---------------------------------------------------------------------------
# nixlbench, built without CUDA (VRAM support is disabled automatically).
# ---------------------------------------------------------------------------
FROM toolchain AS nixlbench

COPY --from=nixl /opt/nixl /opt/nixl
COPY --from=nixl-src /src/nixl/benchmark/nixlbench /src/nixlbench

RUN set -eux; \
    meson setup /tmp/nixlbench-build /src/nixlbench \
        --prefix=/opt/nixlbench \
        --buildtype=release \
        -Dlibdir=lib \
        -Dnixl_path=/opt/nixl; \
    ninja -C /tmp/nixlbench-build; \
    ninja -C /tmp/nixlbench-build install

# ---------------------------------------------------------------------------
# Package: collect the three installs, strip them and drop build-only files.
# A separate stage so the cleanup actually shrinks what the runtime copies.
# ---------------------------------------------------------------------------
FROM toolchain AS dist

COPY --from=ucx /opt/ucx /dist/ucx
COPY --from=nixl /opt/nixl /dist/nixl
COPY --from=nixlbench /opt/nixlbench /dist/nixlbench

RUN find /dist -type f \( -name '*.so*' -o -path '*/bin/*' \) -exec strip --strip-unneeded {} + 2>/dev/null || true; \
    rm -rf /dist/ucx/share /dist/ucx/include /dist/ucx/lib/pkgconfig /dist/ucx/lib/cmake \
           /dist/nixl/include /dist/nixl/lib/pkgconfig /dist/nixl/lib/*.a \
           /dist/nixl/lib/python*

# ---------------------------------------------------------------------------
# Runtime image.
# ---------------------------------------------------------------------------
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# Runtime libraries only. ibverbs-providers carries the mlx5 provider so UCX
# can use a ConnectX device when one is visible in the pod.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ibverbs-providers \
        iproute2 \
        libgflags2.2 \
        libgomp1 \
        libhwloc15 \
        libibverbs1 \
        libnuma1 \
        librdmacm1t64 \
        libtomlplusplus3t64 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=dist /dist/ucx /opt/ucx
COPY --from=dist /dist/nixl /opt/nixl
COPY --from=dist /dist/nixlbench /opt/nixlbench

ENV PATH=/opt/nixlbench/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/ucx/lib:/opt/nixl/lib
ENV NIXL_PLUGIN_DIR=/opt/nixl/lib/plugins

CMD ["bash"]
