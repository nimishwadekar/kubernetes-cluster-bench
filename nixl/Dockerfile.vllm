# NIXLBench image built on the official vLLM runtime.
#
# The vLLM image already contains NIXL 1.4.1 and its CUDA 13 wheel,
# including the bundled UCX 1.22.0 runtime. This image adds only the
# NIXLBench C++ executable and its build-time integration:
#   - matching NIXL v1.4.1 headers and nixlbench sources
#   - Meson/Ninja and native build dependencies
#   - a link prefix that combines wheel libraries with source headers
#
# Build for the GPU nodes' architecture:
#   docker buildx build --platform linux/amd64 \
#     -f nixl/Dockerfile.vllm-nixlbench \
#     -t nixlbench:vllm-0.31.0-nixl-1.4.1 \
#     --load .

FROM vllm/vllm-openai:v0.31.0

ARG NIXL_VERSION=v1.4.1
ARG PYTHON_VERSION=3.12
ARG NIXL_WHEEL_LIB_DIR=/usr/local/lib/python3.12/dist-packages/.nixl_cu13.mesonpy.libs
ARG NIXL_WHEEL_EXTRA_LIB_DIR=/usr/local/lib/python3.12/dist-packages/nixl_cu13.libs
ARG NIXL_LINK_PREFIX=/opt/nixl-for-bench
ARG NIXLBENCH_PREFIX=/usr/local/nixlbench

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        flex \
        git \
        libaio-dev \
        libclang-dev \
        libcpprest-dev \
        libcurl4-openssl-dev \
        libgflags-dev \
        libgtest-dev \
        libhwloc-dev \
        libibumad-dev \
        libibverbs-dev \
        libnuma-dev \
        libprotobuf-dev \
        librdmacm-dev \
        libssl-dev \
        libxml2-dev \
        libz-dev \
        libzstd-dev \
        ninja-build \
        pkg-config \
        protobuf-compiler \
        protobuf-compiler-grpc \
        python3-dev \
        python3-pip \
        python3-venv \
        rdma-core \
        uuid-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/nixlbench-venv && \
    /opt/nixlbench-venv/bin/pip install --no-cache-dir \
        meson \
        ninja

ENV PATH=/opt/nixlbench-venv/bin:${NIXLBENCH_PREFIX}/bin:${PATH}
ENV NIXL_LINK_PREFIX=${NIXL_LINK_PREFIX}
ENV NIXLBENCH_PREFIX=${NIXLBENCH_PREFIX}
ENV NIXL_PLUGIN_DIR=${NIXL_LINK_PREFIX}/lib64/plugins
ENV LD_LIBRARY_PATH=${NIXL_LINK_PREFIX}/lib64:${NIXL_WHEEL_LIB_DIR}:${NIXL_WHEEL_EXTRA_LIB_DIR}:${NIXL_WHEEL_LIB_DIR}/plugins:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# The wheel contains NIXL and UCX runtime libraries, but not the C++ headers
# required by NIXLBench. Clone only the matching NIXL source for headers and
# benchmark sources; do not rebuild NIXL or UCX.
RUN set -eux; \
    test -d "${NIXL_WHEEL_LIB_DIR}"; \
    test -f "${NIXL_WHEEL_LIB_DIR}/libnixl.so"; \
    test -d "${NIXL_WHEEL_LIB_DIR}/plugins"; \
    test -d "${NIXL_WHEEL_EXTRA_LIB_DIR}"; \
    UCX_LIB=$(find "${NIXL_WHEEL_EXTRA_LIB_DIR}" -maxdepth 1 -name 'libucp-*.so*' -print -quit); \
    ETCD_LIB=$(find "${NIXL_WHEEL_EXTRA_LIB_DIR}" -maxdepth 1 -name 'libetcd-cpp-api-core-*.so' -print -quit); \
    test -n "${UCX_LIB}"; \
    test -n "${ETCD_LIB}"; \
    git clone --depth 1 --branch "${NIXL_VERSION}" \
        https://github.com/ai-dynamo/nixl.git /tmp/nixl; \
    mkdir -p "${NIXL_LINK_PREFIX}/include" "${NIXL_LINK_PREFIX}/lib64"; \
    cp -a /tmp/nixl/src/api/cpp/*.h "${NIXL_LINK_PREFIX}/include/"; \
    for subdir in backend telemetry; do \
        if [ -d "/tmp/nixl/src/api/cpp/${subdir}" ]; then \
            mkdir -p "${NIXL_LINK_PREFIX}/include/${subdir}"; \
            cp -a "/tmp/nixl/src/api/cpp/${subdir}/." \
                "${NIXL_LINK_PREFIX}/include/${subdir}/"; \
        fi; \
    done; \
    mkdir -p "${NIXL_LINK_PREFIX}/include/utils"; \
    cp -a /tmp/nixl/src/utils/. "${NIXL_LINK_PREFIX}/include/utils/"; \
    for lib in "${NIXL_WHEEL_LIB_DIR}"/*.so* "${NIXL_WHEEL_EXTRA_LIB_DIR}"/*.so*; do \
        [ -e "${lib}" ] || continue; \
        ln -sfn "${lib}" "${NIXL_LINK_PREFIX}/lib64/$(basename "${lib}")"; \
    done; \
    ln -sfn "${NIXL_WHEEL_LIB_DIR}/plugins" \
        "${NIXL_LINK_PREFIX}/lib64/plugins"; \
    ln -sfn "${ETCD_LIB}" \
        "${NIXL_LINK_PREFIX}/lib64/libetcd-cpp-api-core.so"; \
    test -e "${NIXL_LINK_PREFIX}/lib64/libnixl.so"; \
    test -e "${NIXL_LINK_PREFIX}/lib64/libetcd-cpp-api-core.so"

# Build only the benchmark. The wheel supplies NIXL, UCX, Abseil, gRPC,
# protobuf, and etcd-cpp runtime libraries.
RUN set -eux; \
    meson setup /tmp/nixlbench-build /tmp/nixl/benchmark/nixlbench \
        --prefix="${NIXLBENCH_PREFIX}" \
        --buildtype=release \
        -Dlibdir=lib64 \
        -Dnixl_path="${NIXL_LINK_PREFIX}" \
        -Dcudapath_inc=/usr/local/cuda/include \
        -Dcudapath_lib=/usr/local/cuda/lib64 \
        -Dcudapath_stub=/usr/local/cuda/lib64/stubs \
        -Detcd_inc_path=/usr/local/include \
        -Detcd_lib_path="${NIXL_LINK_PREFIX}/lib64"; \
    ASIO_INC=$(find /tmp/nixl/benchmark/nixlbench/subprojects \
        -path '*/asio-*/include/asio.hpp' -printf '%h\n' 2>/dev/null | head -1); \
    test -n "${ASIO_INC}"; \
    export CPATH="${ASIO_INC}:${NIXL_LINK_PREFIX}/include:/usr/local/cuda/include"; \
    ninja -C /tmp/nixlbench-build; \
    ninja -C /tmp/nixlbench-build install; \
    ln -sfn "${NIXLBENCH_PREFIX}/bin/nixlbench" /usr/local/bin/nixlbench; \
    rm -rf /tmp/nixl /tmp/nixlbench-build

# The inherited vLLM entrypoint is not appropriate for a benchmark image.
ENTRYPOINT []
CMD ["bash"]
